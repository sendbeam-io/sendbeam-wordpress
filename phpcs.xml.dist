<?xml version="1.0"?>
<ruleset name="SendBeam">
	<description>WordPress Coding Standards for the SendBeam plugin.</description>

	<file>.</file>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<rule ref="WordPress"/>

	<!--
	blocks/form/index.asset.php is the name WordPress itself looks for beside
	index.js; @wordpress/scripts writes it and register_block_type() reads it,
	so it cannot be hyphenated.
	-->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/index.asset.php</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="6.0"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sendbeam"/>
			</property>
		</properties>
	</rule>
</ruleset>
