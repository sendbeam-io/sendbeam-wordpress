{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sendbeam/form",
	"version": "1.8.4",
	"title": "SendBeam Form",
	"category": "widgets",
	"icon": "email-alt",
	"description": "A newsletter signup or contact form from your SendBeam account.",
	"keywords": [ "newsletter", "signup", "subscribe", "contact", "email" ],
	"textdomain": "sendbeam",
	"attributes": {
		"formId": { "type": "string", "default": "" },
		"height": { "type": "number", "default": 520 }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
